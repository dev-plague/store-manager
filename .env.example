# Copia este archivo a `.env` y ajusta los valores.

# Conexión a PostgreSQL (Docker Compose).
DATABASE_URL="postgresql://store:store@localhost:5432/store_manager"

# Secreto de Better Auth. Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET="secreto-de-al-menos-32-caracteres"

# URL pública de la aplicación (usada por Better Auth para cookies/redirects).
BETTER_AUTH_URL="http://localhost:5173"

# Entorno de ejecución.
NODE_ENV="development"
